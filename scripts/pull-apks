#!/usr/bin/env bash
# pull-apks – pull installed APKs from a connected ADB device into apks/<package>/
# Usage: ./scripts/pull-apks [--serial <SERIAL>] [<package>...]
# If no packages given, prompts or reads from apks/packages.txt
set -euo pipefail

SERIAL="${ANDROID_SERIAL:-}"
PACKAGES=()
APKS_DIR="$(cd "$(dirname "$0")/.." && pwd)/apks"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --serial|-s)
      [[ -n "${2:-}" ]] || {
        echo "ERROR: --serial requires a value." >&2
        echo "Usage: $(basename "$0") [--serial <SERIAL>] [<package>...]" >&2
        exit 1
      }
      SERIAL="$2"; shift 2 ;;
    --help|-h)
      echo "Usage: $(basename "$0") [--serial <SERIAL>] [<package>...]"
      echo ""
      echo "Pulls APK(s) from connected ADB device into apks/<package>/"
      echo "If no packages given, reads apks/packages.txt (one per line)."
      exit 0 ;;
    *) PACKAGES+=("$1"); shift ;;
  esac
done

ADB=(adb)
[[ -n "$SERIAL" ]] && ADB+=(-s "$SERIAL")

# Verify device
if ! "${ADB[@]}" get-state >/dev/null 2>&1; then
  echo "ERROR: No ADB device found. Connect a device or start an emulator." >&2
  exit 1
fi

DEVICE_SERIAL=$("${ADB[@]}" get-serialno 2>/dev/null)
echo "Device: $DEVICE_SERIAL"

# Load from packages.txt if none given
if [[ ${#PACKAGES[@]} -eq 0 ]]; then
  PKG_FILE="$APKS_DIR/packages.txt"
  if [[ -f "$PKG_FILE" ]]; then
    while IFS= read -r line; do
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [[ -z "$line" || "$line" == \#* ]] && continue
      PACKAGES+=("$line")
    done < "$PKG_FILE"
  else
    echo "ERROR: No packages specified and $PKG_FILE not found." >&2
    echo "Usage: $(basename "$0") <package> [<package>...]" >&2
    exit 1
  fi
fi

PULLED=0
SKIPPED=0
FAILED=0

for PKG in "${PACKAGES[@]}"; do
  if [[ ! "$PKG" =~ ^([A-Za-z0-9_]+)(\.[A-Za-z0-9_]+)*$ ]]; then
    echo "FAIL  $PKG (invalid package name)" >&2
    ((FAILED+=1))
    continue
  fi
  DEST_ABS="$APKS_DIR/$PKG"

  if ! PM_PATH_RAW=$("${ADB[@]}" shell pm path "$PKG" 2>/dev/null); then
    echo "FAIL  $PKG (pm path query failed)" >&2
    ((FAILED+=1))
    continue
  fi
  PATHS=$(printf '%s' "$PM_PATH_RAW" | tr -d '\r')
  if [[ -z "$PATHS" ]]; then
    echo "SKIP  $PKG (not installed on device; preserved prior pull set)"
    ((SKIPPED+=1))
    continue
  fi

  STAGE_DIR="$APKS_DIR/.staging-$PKG-$$"
  rm -rf "$STAGE_DIR"
  mkdir -p "$STAGE_DIR"
  echo "Pulling $PKG..."
  package_failed=0

  while IFS= read -r line; do
    APK_PATH="${line#package:}"
    FNAME=$(basename "$APK_PATH")
    if "${ADB[@]}" pull "$APK_PATH" "$STAGE_DIR/$FNAME" >/dev/null 2>&1; then
      SIZE=$(du -sh "$STAGE_DIR/$FNAME" | cut -f1)
      echo "  ✓  $FNAME ($SIZE)"
      ((PULLED+=1))
    else
      echo "  ✗  $FNAME (pull failed)" >&2
      package_failed=1
      ((FAILED+=1))
    fi
  done <<< "$PATHS"

  if (( package_failed > 0 )); then
    rm -rf "$STAGE_DIR"
    echo "FAIL  $PKG (preserved prior pull set)" >&2
    continue
  fi

  rm -rf "$DEST_ABS"
  mv "$STAGE_DIR" "$DEST_ABS"
done

echo ""
echo "Done: $PULLED APK(s) pulled, $SKIPPED skipped, $FAILED failed."
echo "APKs saved to: $APKS_DIR/"

if (( FAILED > 0 )); then
  exit 1
fi
