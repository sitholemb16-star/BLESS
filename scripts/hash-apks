#!/usr/bin/env bash
# hash-apks – generate SHA256SUMS.txt manifest for all APKs in apks/
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APKS_DIR="$REPO_ROOT/apks"
OUT="$APKS_DIR/SHA256SUMS.txt"

if ! find "$APKS_DIR" -type f \( -name "*.apk" -o -name "*.apks" \) -print -quit | grep -q .; then
  : > "$OUT"
  echo "No APK/APKS files found under $APKS_DIR"
  echo "Manifest written: $OUT"
  exit 0
fi

python3 - "$REPO_ROOT" "$APKS_DIR" "$OUT" <<'PY'
import hashlib
import os
import sys

repo_root, apks_dir, out = sys.argv[1:4]
paths = []
for root, _, files in os.walk(apks_dir):
    for name in files:
        if name.endswith(".apk") or name.endswith(".apks"):
            paths.append(os.path.join(root, name))
paths.sort()

with open(out, "w", encoding="utf-8") as fh:
    for path in paths:
        rel = os.path.relpath(path, repo_root)
        h = hashlib.sha256()
        with open(path, "rb") as src:
            for chunk in iter(lambda: src.read(1024 * 1024), b""):
                h.update(chunk)
        fh.write(f"{h.hexdigest()}  {rel}\n")
PY

echo "Manifest written: $OUT"
cat "$OUT"
