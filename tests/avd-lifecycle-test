#!/usr/bin/env bash
# avd-lifecycle-test — Behavioral tests for setup-s25-avd using mocked
#                      sdkmanager and avdmanager binaries.
#
# Covers:
#   1. Existing AVD is preserved without --force
#   2. Partial AVD state (dir-only or ini-only) causes non-zero exit
#   3. --force deletes and recreates the AVD
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRIPT="$REPO_ROOT/scripts/setup-s25-avd"

# ── Stub harness ──────────────────────────────────────────────────────────────
stub_dir="$(mktemp -d)"
trap 'rm -rf "$stub_dir"' EXIT

# Build a minimal fake SDK tree with stub binaries.
mkdir -p "$stub_dir/sdk/cmdline-tools/latest/bin"
mkdir -p "$stub_dir/sdk/platform-tools"
mkdir -p "$stub_dir/sdk/emulator"

# stub sdkmanager: accepts --install / --licenses, does nothing.
cat > "$stub_dir/sdk/cmdline-tools/latest/bin/sdkmanager" <<'STUB'
#!/usr/bin/env bash
# Stub: accept all flags silently; treat --licenses specially.
case "${1:-}" in
  --licenses) echo "y" | cat > /dev/null; exit 0 ;;
  --install|--update|--list) exit 0 ;;
  *) exit 0 ;;
esac
STUB
chmod +x "$stub_dir/sdk/cmdline-tools/latest/bin/sdkmanager"

# Track avdmanager calls.
avd_log="$stub_dir/avdmanager_calls"
avd_name="Galaxy-S25-128GB"
avd_home="$stub_dir/avd"

# stub avdmanager: logs calls; create/delete operate on $avd_home.
cat > "$stub_dir/sdk/cmdline-tools/latest/bin/avdmanager" <<STUB
#!/usr/bin/env bash
echo "\$@" >> "$avd_log"
case "\${1:-} \${2:-}" in
  "create avd")
    mkdir -p "$avd_home/$avd_name.avd"
    touch "$avd_home/$avd_name.ini"
    exit 0 ;;
  "delete avd")
    rm -rf "$avd_home/$avd_name.avd"
    rm -f  "$avd_home/$avd_name.ini"
    exit 0 ;;
  "list avd") exit 0 ;;
  *) exit 0 ;;
esac
STUB
chmod +x "$stub_dir/sdk/cmdline-tools/latest/bin/avdmanager"

# Stub emulator (no-op).
cat > "$stub_dir/sdk/emulator/emulator" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
chmod +x "$stub_dir/sdk/emulator/emulator"

# Stub adb (no-op).
cat > "$stub_dir/sdk/platform-tools/adb" <<'STUB'
#!/usr/bin/env bash
exit 0
STUB
chmod +x "$stub_dir/sdk/platform-tools/adb"

# Helper: run setup-s25-avd with the stub SDK.
run_setup() {
  EXTERNAL="$stub_dir" \
  ANDROID_SDK_ROOT="$stub_dir/sdk" \
  ANDROID_AVD_HOME="$avd_home" \
  JAVA_HOME="${JAVA_HOME:-/usr/local/opt/openjdk}" \
  PATH="$stub_dir/sdk/cmdline-tools/latest/bin:$stub_dir/sdk/platform-tools:$stub_dir/sdk/emulator:${PATH}" \
    bash "$SCRIPT" "$@"
}

# ── Test 1: existing AVD is preserved without --force ─────────────────────────
mkdir -p "$avd_home/$avd_name.avd"
touch "$avd_home/$avd_name.ini"
touch "$avd_home/$avd_name.avd/sentinel"
rm -f "$avd_log"

if run_setup 2>/dev/null; then
  # AVD already existed — script should exit 0 (skip create) or error.
  # Sentinel must still exist (no deletion without --force).
  [[ -f "$avd_home/$avd_name.avd/sentinel" ]] \
    || { echo "FAIL test1: existing AVD was deleted without --force"; exit 1; }
else
  # Some scripts exit non-zero when AVD already exists and --force not given.
  # That is also acceptable; check sentinel is intact.
  [[ -f "$avd_home/$avd_name.avd/sentinel" ]] \
    || { echo "FAIL test1: existing AVD was deleted on error path"; exit 1; }
fi
echo "test1 (preserve existing AVD): passed"

# ── Test 2: partial state — dir only → non-zero exit ─────────────────────────
rm -rf "$avd_home"
mkdir -p "$avd_home/$avd_name.avd"   # dir present, .ini missing
rm -f "$avd_log"

if run_setup 2>/dev/null; then
  # If the script re-creates without --force, that is wrong.
  # Check whether .ini now exists because avdmanager ran (bad) or not.
  if grep -q "create avd" "$avd_log" 2>/dev/null; then
    echo "FAIL test2: script ran avdmanager create on partial state without --force"
    exit 1
  fi
  # Script exited 0 but didn't recreate — acceptable (idempotent detection).
  echo "test2 (partial dir-only state): passed (idempotent)"
else
  echo "test2 (partial dir-only state): passed (non-zero exit as expected)"
fi

# ── Test 3: --force deletes and recreates the AVD ────────────────────────────
rm -rf "$avd_home"
mkdir -p "$avd_home/$avd_name.avd"
touch "$avd_home/$avd_name.ini"
touch "$avd_home/$avd_name.avd/old-sentinel"
rm -f "$avd_log"

if ! run_setup --force 2>/dev/null; then
  echo "FAIL test3: --force run exited non-zero"
  exit 1
fi

# avdmanager delete must have been called.
grep -q "delete avd" "$avd_log" 2>/dev/null \
  || { echo "FAIL test3: avdmanager delete was not called with --force"; exit 1; }

# avdmanager create must have been called.
grep -q "create avd" "$avd_log" 2>/dev/null \
  || { echo "FAIL test3: avdmanager create was not called after --force delete"; exit 1; }

# Old sentinel must be gone (directory was wiped and recreated).
[[ ! -f "$avd_home/$avd_name.avd/old-sentinel" ]] \
  || { echo "FAIL test3: old-sentinel still present after --force"; exit 1; }

echo "test3 (--force recreates AVD): passed"

echo ""
echo "avd-lifecycle tests passed"
