#!/usr/bin/env bash
set -euo pipefail

SCRIPT="scripts/emulator-comm"

pass() { echo "PASS: $1"; }
fail() { echo "FAIL: $1"; exit 1; }

ADB_MOCK_DIR="$(mktemp -d)"
ADB_LOG="$(mktemp)"

cat >"$ADB_MOCK_DIR/adb" <<'ADB'
#!/usr/bin/env bash
set -euo pipefail
LOG_FILE="${ADB_LOG_FILE:?}"
STATE="${ADB_STATE:-device}"
DEVICES="${ADB_DEVICES:-emulator-5554\tdevice}"

echo "adb $*" >> "$LOG_FILE"

if [[ "${1:-}" == "-s" ]]; then
  shift 2
fi

case "${1:-}" in
  get-state)
    if [[ "$STATE" == "none" ]]; then
      exit 1
    fi
    echo "$STATE"
    ;;
  devices)
    echo -e "List of devices attached\n$DEVICES\n"
    ;;
  shell)
    exit 0
    ;;
  emu)
    exit 0
    ;;
  *)
    exit 0
    ;;
esac
ADB
chmod +x "$ADB_MOCK_DIR/adb"

export PATH="$ADB_MOCK_DIR:$PATH"
export ADB_LOG_FILE="$ADB_LOG"

# help output validation
if "$SCRIPT" --help | grep -q "Usage:"; then
  pass "help output"
else
  fail "help output"
fi

# mocked ADB flow: status should pass on emulator
export ADB_STATE=device
export ADB_DEVICES='emulator-5554	device'
if "$SCRIPT" status | grep -q "type=emulator"; then
  pass "status emulator"
else
  fail "status emulator"
fi

# mocked ADB flow: outgoing call
if "$SCRIPT" call-start 12345 | grep -q "CALL_OUTGOING_STARTED"; then
  pass "call-start"
else
  fail "call-start"
fi

# physical-device restriction for incoming inject
export ADB_DEVICES='R58M123ABC	device'
if "$SCRIPT" call-incoming 12345 >/tmp/emc.out 2>/tmp/emc.err; then
  fail "physical restriction should fail"
else
  if grep -q "UNSUPPORTED_ON_PHYSICAL_DEVICE" /tmp/emc.err; then
    pass "physical-device restriction"
  else
    fail "physical-device restriction message"
  fi
fi

# mocked incoming sms on emulator
export ADB_DEVICES='emulator-5554	device'
if "$SCRIPT" sms-incoming 12345 hello | grep -q "SMS_INCOMING_INJECTED"; then
  pass "sms-incoming"
else
  fail "sms-incoming"
fi

if grep -q "adb" "$ADB_LOG"; then
  pass "adb mocked flows invoked"
else
  fail "adb mocked flows invoked"
fi

echo "ALL TESTS PASSED"
